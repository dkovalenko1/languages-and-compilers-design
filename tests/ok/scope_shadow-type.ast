Program
  Decl x i32 mut
    Const 5
  If
    Bool true
    Block
      Decl x bool const
        Bool false
      If
        Not
          Var x
        Block
          Decl x i64 mut
            Const 3000000000
          Assign x
            BinOp +
              Var x
              Const 1
  Assign x
    BinOp +
      Var x
      Const 1
  Exit
    Var x
