        Call ping
          Var n
  Decl x i32 const
    Const 1
  Decl base i32 const
    Const 2
  Lambda add -> i32
    Struct lambda.add
      Member base i32 const
      MemberFn call -> i32
        Param v i32
        Block
          Decl r i32 const
            BinOp +
              Call sq
                Var v
              Var base
          Exit
            Var r
    Decl add lambda.add const
      Var base
  Decl p Point mut
    Var x
    Const 3
  Decl total i32 mut
    Const 0
  If
    Bool true
    Block
      Decl x i32 const
        Const 10
      Assign total
        BinOp +
          Var x
          MemberCall sum
            Var p
  Decl plus Adder const
