Program
  Struct Point
    FieldDecl x i32 mut
    FieldDecl y i32 mut
    MemberFn sum -> i32
      Block
        Decl s i32 const
          BinOp +
            Var x
            Var y
        Exit
          Var s
  Struct Adder
    FieldDecl by i32 const
    MemberFn call -> i32
      Param v i32
      Block
        Decl r i32 const
          BinOp +
            Call offset
              Var v
            Var by
        Exit
